<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>seedgen</AssemblyName>
    <RootNamespace>Wick.SeedGen</RootNamespace>
    <!-- Match Unity's compiler so sim code that builds here also builds in Unity. -->
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The sim comes through Wick.Bots, which links it (one source for Unity, server and tools). -->
    <ProjectReference Include="../Wick.Bots/Wick.Bots.csproj" />
  </ItemGroup>

</Project>
