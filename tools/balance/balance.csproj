<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>balance</AssemblyName>
    <RootNamespace>Wick.Balance</RootNamespace>
    <!-- Match Unity's compiler so sim code that builds here also builds in Unity. -->
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The sim comes through Wick.Bots, which links it (one source for Unity, server and tools). -->
    <ProjectReference Include="../Wick.Bots/Wick.Bots.csproj" />
    <!-- Economy types, shared with the game and Cloud Code the same way. -->
    <Compile Include="../../unity/Assets/_Wick/Economy/**/*.cs" LinkBase="Economy" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
