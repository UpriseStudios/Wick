/* Layout and sizes for the raid scene's screens (panel units: 1080 x 1920 reference).
   The look (wood, leather, gold, crimson, lettering, icons) comes from UiKit.uss, generated by UiKitBuilder. */

.root {
    flex-grow: 1;
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.hidden {
    display: none;
}

.icon {
    flex-shrink: 0;
}

.res-icon {
    width: 56px;
    height: 56px;
    margin-right: 10px;
}

.res-label {
    font-size: 44px;
}

/* ---- HUD ---------------------------------------------------------------------- */

.hud {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 36px 32px 0 32px;
}

.flickers {
    flex-direction: row;
    padding: 14px 20px;
}

.flicker {
    width: 52px;
    height: 68px;
    margin: 0 4px;
}

.timer {
    font-size: 78px;
    padding: 2px 40px 8px 40px;
    -unity-text-align: middle-center;
}

.timer.urgent {
    color: rgb(255, 120, 100);
}

.loot-plaque {
    flex-direction: row;
    align-items: center;
    padding: 12px 26px 12px 18px;
}

.loot {
    font-size: 54px;
}

.banner {
    position: absolute;
    top: 22%;
    left: 0; right: 0;
    -unity-text-align: middle-center;
    font-size: 72px;
}

.stealth-icon {
    position: absolute;
    left: 40px;
    bottom: 300px;
    padding: 10px 28px;
    opacity: 0;
}

.stealth-icon.active {
    opacity: 1;
}

.stealth-text {
    font-size: 40px;
    color: rgb(190, 200, 230);
}

.bottom-right {
    position: absolute;
    right: 36px;
    bottom: 48px;
    flex-direction: row;
    align-items: flex-end;
}

.bottom-right .round-button {
    margin-left: 36px;
}

.round-button, .round {
    width: 196px;
    height: 196px;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
}

.round-icon {
    width: 104px;
    height: 104px;
}

.round-caption {
    position: absolute;
    bottom: -18px;
    font-size: 34px;
}

.round-button.used {
    opacity: 0.4;
}

#stealth-button.active {
    scale: 1.08 1.08;
}

/* ---- Home --------------------------------------------------------------------- */

.home {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.home-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 32px 28px 0 28px;
}

.player {
    flex-direction: row;
    align-items: center;
    padding: 14px 30px 14px 14px;
}

.avatar {
    width: 112px;
    height: 112px;
    margin-right: 18px;
}

.player-name {
    font-size: 44px;
}

.res-row {
    flex-direction: row;
    align-items: center;
}

.wallet {
    align-items: flex-end;
}

.res {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    min-width: 320px;
    padding: 10px 26px 10px 18px;
    margin-bottom: 12px;
}

.home-side {
    position: absolute;
    top: 480px;
}

.home-side.right {
    right: 26px;
}

.home-side.left {
    left: 26px;
}

.home-side .round {
    width: 166px;
    height: 166px;
    margin-bottom: 44px;
}

.home-side .round-icon {
    width: 92px;
    height: 92px;
}

.home-side .round-caption {
    font-size: 30px;
}

.badge {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 56px;
    height: 56px;
    border-radius: 28px;
    border-width: 5px;
    border-color: rgb(26, 15, 8);
    background-color: rgb(194, 67, 63);
    font-size: 32px;
    -unity-text-align: middle-center;
    padding: 0 8px;
}

.prompt-box {
    position: absolute;
    left: 220px;
    right: 220px;
    top: 560px;
    align-items: center;
}

.prompt-text {
    margin-bottom: 20px;
    padding: 24px 36px;
    border-radius: 28px;
    background-color: rgba(14, 8, 4, 0.82);
}

.prompt-list {
    width: 100%;
    align-items: center;
}

.prompt-row {
    flex-direction: row;
    margin-bottom: 16px;
}

.upgrade-chip {
    position: absolute;
    left: 50%;
    bottom: 330px;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: 14px 34px 14px 20px;
    margin: 0;
}

.raid-button {
    position: absolute;
    left: 36px;
    bottom: 64px;
    width: 470px;
    height: 250px;
    align-items: center;
    justify-content: center;
    padding: 0 0 18px 0;
    margin: 0;
}

.raid-label {
    font-size: 108px;
    -unity-text-align: middle-center;
}

.raid-sub {
    font-size: 36px;
    margin-top: -14px;
}

.build-button {
    position: absolute;
    right: 36px;
    bottom: 64px;
    width: 300px;
    height: 210px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0 0 14px 0;
    margin: 0;
}

.build-icon {
    width: 84px;
    height: 84px;
    margin-right: 10px;
}

.build-label {
    font-size: 58px;
}

/* ---- Menus: a dimmed overlay with a carved panel, ribbon title and close button ---- */

.overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(10, 6, 3, 0.72);
    align-items: center;
    justify-content: center;
}

.sheet-card {
    width: 94%;
    height: 82%;
    padding: 110px 34px 30px 34px;
    margin-top: 60px;
}

.ribbon {
    position: absolute;
    top: -46px;
    left: 18%;
    right: 18%;
    height: 116px;
    font-size: 60px;
    -unity-text-align: middle-center;
    padding-bottom: 10px;
}

.close-button {
    position: absolute;
    top: -40px;
    right: -14px;
    width: 116px;
    height: 116px;
    font-size: 62px;
    padding: 0 0 10px 0;
    margin: 0;
}

.sheet-subtitle {
    font-size: 36px;
    color: rgb(222, 200, 160);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 16px;
}

.sheet-list {
    flex-grow: 1;
}

.log-row {
    padding: 26px 30px 24px 30px;
    margin: 10px 0;
}

.log-text {
    font-size: 36px;
    white-space: normal;
}

.log-buttons {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 14px;
}

.log-button {
    height: 104px;
    padding: 0 34px 10px 34px;
    margin: 0 16px 8px 0;
    font-size: 38px;
}

/* ---- Results ---------------------------------------------------------------- */

.results-card {
    width: 90%;
    padding: 60px 40px 50px 40px;
    align-items: center;
}

.title {
    font-size: 120px;
    margin-bottom: 16px;
}

.stars {
    flex-direction: row;
    margin-bottom: 20px;
}

.star {
    width: 150px;
    height: 150px;
    margin: 0 14px;
}

.loot-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 26px;
}

.result-loot {
    font-size: 64px;
}

.result-buttons {
    flex-direction: row;
    width: 100%;
    margin-top: 18px;
}

.result-button {
    flex-grow: 1;
    width: auto;
    margin: 0 10px;
}

.wide-button {
    height: 150px;
    margin: 14px 0;
    padding: 0 0 12px 0;
    font-size: 52px;
    width: 86%;
}

.wide-button.small {
    height: 110px;
    font-size: 38px;
    margin: 8px 0;
}

.share-row {
    flex-direction: row;
    width: 100%;
    margin-bottom: 10px;
}

.share-button {
    flex-grow: 1;
    height: 120px;
    margin: 0 10px;
    padding-bottom: 10px;
    font-size: 40px;
}

.dev-block {
    margin: 10px 0 20px 0;
    align-items: center;
}

.mono {
    font-size: 30px;
    color: rgb(200, 186, 160);
}

.match {
    font-size: 40px;
    color: rgb(150, 220, 130);
}

.match.bad {
    color: rgb(255, 120, 100);
}

/* ---- Title ----------------------------------------------------------------- */

.title-screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.title-tap {
    position: absolute;
    left: 0; right: 0;
    bottom: 230px;
    font-size: 72px;
    -unity-text-align: middle-center;
}

.title-bar {
    position: absolute;
    left: 16%; right: 16%;
    bottom: 140px;
    height: 56px;
    padding: 8px;
}

.title-fill {
    height: 100%;
    width: 0%;
}

.title-version {
    position: absolute;
    right: 40px;
    bottom: 40px;
    font-size: 30px;
    color: rgba(244, 230, 198, 0.6);
}

/* ---- Server messages ------------------------------------------------------------ */

.server-verdict {
    font-size: 40px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 0 30px 24px 30px;
    color: rgb(244, 230, 198);
}

.server-verdict.good {
    color: rgb(170, 225, 140);
}

.server-verdict.bad {
    color: rgb(255, 150, 120);
}

/* ---- Dev menu and test vaults ----------------------------------------------------- */

.dev-toggle {
    position: absolute;
    left: 24px;
    top: 330px;
    width: 120px;
    height: 72px;
    font-size: 28px;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0.45);
    background-image: none;
    border-width: 0;
}

.dev-panel {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 420px;
    padding: 32px;
    border-radius: 24px;
    background-color: rgba(12, 8, 5, 0.94);
}

.dev-panel Toggle {
    font-size: 36px;
    margin: 10px 0;
}

.section {
    font-size: 36px;
    color: rgb(226, 166, 62);
    margin: 24px 0 6px 0;
}

.golden-list {
    max-height: 600px;
    margin: 12px 0 20px 0;
}

.golden-list .wide-button, .sheet-list .wide-button {
    width: 100%;
    height: 110px;
    font-size: 36px;
    margin: 8px 0;
}

.id-row {
    flex-direction: row;
    align-items: center;
}

.id-field {
    flex-grow: 1;
    font-size: 34px;
    height: 100px;
}

.id-field TextInput {
    font-size: 34px;
    -unity-text-align: middle-left;
}

/* ---- Replays ----------------------------------------------------------------------- */

.replay-bar {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 60px;
    flex-direction: row;
    align-items: center;
    padding: 18px;
}

.bar-button {
    width: 180px;
    height: 104px;
    font-size: 36px;
    padding-bottom: 8px;
}

.scrub {
    flex-grow: 1;
    margin: 0 20px;
}

.scrub #unity-dragger {
    width: 56px;
    height: 56px;
    margin-top: -24px;
    border-radius: 28px;
    background-color: rgb(226, 166, 62);
}

/* Gold flying from Wick to the loot counter (RaidUI.FlyCoins). */
.fly-coin {
    position: absolute;
    width: 64px;
    height: 64px;
    margin-left: -32px;
    margin-top: -32px;
}
