/* Generated by Wick > Art > Build UI Kit (Editor/UiKitBuilder.cs). Loaded after each screen's own styles. */

/* Baloo 2 (SIL Open Font License, Art/Fonts): Medium for reading, ExtraBold for titles, buttons and numbers. */
.root { -unity-font-definition: url("project://database/Assets/_Wick/Art/Fonts/Baloo2-Medium.asset?fileID=11400000&guid=7da5c3111613744439da09ffee40dc3e&type=2#Baloo2-Medium"); }
.title, .section-title, .subtitle, .wide-button, .log-button, .share-button, .bar-button, .round-button, .loot, .timer, .banner, .action, .small-button, .sel-button, .tab, .vault-name, .level, .fly-coin {
    -unity-font-definition: url("project://database/Assets/_Wick/Art/Fonts/Baloo2-ExtraBold.asset?fileID=11400000&guid=e31ef428f0e6ef74185c5d7dacad9858&type=2#Baloo2-ExtraBold");
    -unity-font-style: normal; /* the weight is in the face; no faux bold */
}

.wide-button, .log-button, .share-button, .bar-button, .action, .small-button, .sel-button, .tab {
    background-image: url("project://database/Assets/_Wick/Art/StandIns/UI/ui_button_primary.png?fileID=21300000&guid=f663fd8a88620bb4face3f13c88761d4&type=3#ui_button_primary");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: rgb(43, 29, 20);
}

.wide-button.secondary, .tab.off {
    background-image: url("project://database/Assets/_Wick/Art/StandIns/UI/ui_button_secondary.png?fileID=21300000&guid=bf30b41c4450cb84693050f704068e98&type=3#ui_button_secondary");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: rgb(43, 29, 20);
}

.log-button.revenge {
    background-image: url("project://database/Assets/_Wick/Art/StandIns/UI/ui_button_danger.png?fileID=21300000&guid=f02614279283a0142b7fda9e105fdbc3&type=3#ui_button_danger");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: rgb(255, 245, 235);
}

.log-row, .draft-row, .issue-row {
    background-image: url("project://database/Assets/_Wick/Art/StandIns/UI/ui_row.png?fileID=21300000&guid=75a8baeaa2093d342995afef291b2291&type=3#ui_row");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

.card {
    background-image: url("project://database/Assets/_Wick/Art/StandIns/UI/ui_panel.png?fileID=21300000&guid=c252dfb75f8233445966e73073a29ea1&type=3#ui_panel");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

.log-row .log-text, .draft-row, .issue-row { color: rgb(43, 29, 20); }
.log-row .log-text.held { color: rgb(30, 110, 60); }
.log-row .log-text.robbed { color: rgb(170, 40, 45); }
.wide-button:disabled, .log-button:disabled { opacity: 0.45; }
