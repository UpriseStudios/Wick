/* Generated by Wick > Art > Build UI Kit (Editor/UiKitBuilder.cs): the look. Layout lives in each screen's stylesheet. */

/* Baloo 2 (SIL OFL): Medium to read, ExtraBold for lettering. Ivory text with an ink outline and drop, like the logo. */
.root { -unity-font-definition: url("project://database/Assets/_Wick/Art/Fonts/Baloo2-Medium.asset?fileID=11400000&guid=7da5c3111613744439da09ffee40dc3e&type=2#Baloo2-Medium"); color: rgb(244, 230, 198); }
.lettering, .title, .section-title, .ribbon, Button, .loot, .timer, .banner, .res-label, .round-caption, .badge {
    -unity-font-definition: url("project://database/Assets/_Wick/Art/Fonts/Baloo2-ExtraBold.asset?fileID=11400000&guid=e31ef428f0e6ef74185c5d7dacad9858&type=2#Baloo2-ExtraBold");
    -unity-font-style: normal;
    color: rgb(244, 230, 198);
    -unity-text-outline-width: 6px;
    -unity-text-outline-color: rgb(26, 15, 8);
    text-shadow: 0 7px 0 rgb(26, 15, 8);
}

