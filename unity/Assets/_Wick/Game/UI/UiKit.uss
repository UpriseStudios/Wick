/* Text on leather and wood stays ivory; held and robbed lines are tinted. */
.log-text { color: rgb(240, 222, 188); }
.log-text.held { color: rgb(180, 222, 150); }
.log-text.robbed { color: rgb(255, 170, 150); }
Button:disabled { opacity: 0.45; }
