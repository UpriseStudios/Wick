/* Layout and sizes for the vault editor (panel units: 1080 x 1920 reference).
   The look (wood, leather, gold, crimson, lettering) comes from ../UI/UiKit.uss: wood buttons for
   ordinary actions, gold for the main one (Test, Publish, the selected tab or tool), crimson for Remove. */

.root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.hidden {
    display: none;
}

/* ---- Your vaults ------------------------------------------------------------------- */

.panel {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(10, 6, 3, 0.9);
    align-items: center;
    justify-content: center;
}

.drafts-card {
    width: 92%;
    max-height: 84%;
    padding: 120px 40px 40px 40px;
    margin-top: 60px;
    align-items: center;
}

.ribbon {
    position: absolute;
    top: -50px;
    left: 12%;
    right: 12%;
    height: 150px;
    font-size: 64px;
    -unity-text-align: middle-center;
    padding-bottom: 10px;
}

.close-button {
    position: absolute;
    top: -40px;
    right: -14px;
    width: 116px;
    height: 116px;
    font-size: 62px;
    padding: 0 0 10px 0;
    margin: 0;
}

.section {
    font-size: 42px;
    color: rgb(246, 210, 122);
    margin: 24px 0 10px 0;
}

.list {
    width: 100%;
}

.wide-button {
    height: 130px;
    margin: 8px 0;
    padding: 0 0 12px 0;
    font-size: 44px;
    flex-grow: 1;
}

.draft-list {
    width: 100%;
    max-height: 720px;
}

.draft-row {
    flex-direction: row;
    align-items: center;
    padding: 14px 16px;
    margin: 6px 0;
}

.draft-row .wide-button {
    margin: 0 6px;
}

#empty {
    font-size: 36px;
    color: rgb(222, 200, 160);
    margin: 20px 0;
    -unity-text-align: middle-center;
    white-space: normal;
}

.small-button {
    height: 96px;
    padding: 0 26px 10px 26px;
    margin: 0 6px;
    font-size: 34px;
}

.tiny-button {
    width: 88px;
    height: 88px;
    padding: 0 0 10px 0;
    font-size: 44px;
}

/* ---- Editor top ------------------------------------------------------------------ */

.editor {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.topbar {
    flex-direction: row;
    align-items: center;
    margin: 30px 16px 0 16px;
    padding: 14px 16px;
}

.vault-name {
    font-size: 40px;
    flex-grow: 1;
    margin: 0 12px;
    overflow: hidden;
}

.level {
    font-size: 38px;
    color: rgb(246, 210, 122);
    margin: 0 12px;
}

.infobar {
    flex-direction: row;
    align-items: center;
    margin: 10px 16px 0 16px;
    padding: 12px 18px;
}

.budget {
    flex-grow: 1;
    margin-right: 20px;
}

.budget-label {
    font-size: 30px;
    margin-bottom: 6px;
}

.budget-track {
    height: 44px;
    padding: 7px;
}

.budget-fill {
    height: 100%;
    width: 0;
}

.budget-fill.over {
    -unity-background-image-tint-color: rgb(255, 110, 100);
}

.route-label {
    font-size: 26px;
    margin-top: 6px;
}

.route-label.short {
    color: rgb(255, 110, 100);
}

.pill {
    height: 96px;
    padding: 0 30px 10px 30px;
    font-size: 34px;
}

.status {
    font-size: 30px;
    margin: 8px 24px 0 24px;
    padding: 10px 20px;
    border-radius: 18px;
    background-color: rgba(14, 8, 4, 0.78);
    -unity-text-align: middle-center;
    white-space: normal;
}

.toast {
    position: absolute;
    top: 320px;
    left: 50px;
    right: 50px;
    padding: 30px;
    font-size: 36px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.issues-panel {
    position: absolute;
    top: 300px;
    left: 30px;
    right: 30px;
    padding: 40px 30px 30px 30px;
}

.issue-list {
    max-height: 700px;
    margin-bottom: 16px;
}

.issue-row {
    font-size: 32px;
    color: rgb(255, 180, 160);
    white-space: normal;
    -unity-text-align: middle-left;
    margin: 6px 0;
    padding: 22px 26px;
}

/* ---- Selection bar (floats above the selected item) ------------------------------ */

.selection-bar {
    position: absolute;
    left: 0;
    top: 0;
    padding: 18px 18px 14px 18px;
    align-items: center;
}

.selection-name {
    font-size: 32px;
    color: rgb(246, 210, 122);
    margin-bottom: 10px;
}

.sel-button {
    height: 100px;
    min-width: 160px;
    padding: 0 22px 10px 22px;
    margin: 0 6px;
    font-size: 32px;
}

/* ---- Editor bottom --------------------------------------------------------------- */

.bottom {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    background-color: rgba(14, 8, 4, 0.9);
    border-top-width: 6px;
    border-color: rgb(26, 15, 8);
}

.hint {
    font-size: 30px;
    color: rgb(222, 200, 160);
    white-space: normal;
    padding: 12px 24px 0 24px;
    -unity-text-align: middle-center;
}

.row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.tabs {
    flex-direction: row;
    padding: 14px 14px 0 14px;
}

.tab {
    flex-grow: 1;
    height: 100px;
    margin: 0 6px;
    padding: 0 0 10px 0;
    font-size: 38px;
}

.shop {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    padding: 12px 10px;
}

.card {
    width: 200px;
    height: 150px;
    margin: 5px;
    align-items: center;
    justify-content: center;
    padding: 8px;
}

.card Label {
    font-size: 30px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.card .card-sub {
    font-size: 26px;
    color: rgb(246, 210, 122);
}

.card.blocked {
    opacity: 0.45;
}

.card.dragging {
    scale: 1.08 1.08;
}

.room-tools {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    padding: 12px 10px;
}

.tool {
    width: 200px;
    height: 110px;
    margin: 5px;
    padding: 0 0 10px 0;
    font-size: 32px;
}

.actions {
    flex-direction: row;
    padding: 12px 12px 44px 12px;
}

.action {
    flex-grow: 1;
    height: 130px;
    margin: 0 6px;
    padding: 0 0 12px 0;
    font-size: 40px;
}

.action:disabled {
    opacity: 0.4;
}

.action.dev {
    flex-grow: 0;
    width: 130px;
    font-size: 28px;
}
