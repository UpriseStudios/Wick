<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="EditorUI.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">

        <!-- Drafts list. -->
        <ui:VisualElement name="drafts" class="panel blocks-input">
            <ui:Label text="Your vaults" class="title" />
            <ui:ScrollView name="draft-list" class="draft-list" />
            <ui:Label text="Start from a template" class="section" />
            <ui:VisualElement name="template-list" class="list" />
            <ui:Button name="back-raids" text="Back to raids" class="wide-button secondary" />
        </ui:VisualElement>

        <!-- Editor. Containers ignore touches so the grid gets them; controls block. -->
        <ui:VisualElement name="editor" class="editor" picking-mode="Ignore">
            <ui:VisualElement class="topbar blocks-input">
                <ui:Button name="to-drafts" text="Vaults" class="small-button" />
                <ui:Label name="vault-name" class="vault-name" />
                <ui:Button name="level-down" text="-" class="tiny-button" />
                <ui:Label name="level-label" text="Lv 1" class="level" />
                <ui:Button name="level-up" text="+" class="tiny-button" />
                <ui:VisualElement class="budget">
                    <ui:VisualElement class="budget-track">
                        <ui:VisualElement name="budget-fill" class="budget-fill" />
                    </ui:VisualElement>
                    <ui:Label name="budget-label" text="0 / 60" class="budget-label" />
                </ui:VisualElement>
                <ui:Button name="issues-button" text="OK" class="small-button issues" />
            </ui:VisualElement>
            <ui:Label name="status" class="status" picking-mode="Ignore" />
            <ui:Label name="toast" class="toast hidden" picking-mode="Ignore" />

            <ui:VisualElement name="issues-panel" class="issues-panel blocks-input">
                <ui:Label text="Fix these to publish" class="section" />
                <ui:ScrollView name="issue-list" class="issue-list" />
                <ui:Button name="issues-close" text="Close" class="small-button" />
            </ui:VisualElement>

            <ui:VisualElement class="bottom" picking-mode="Ignore">
                <ui:VisualElement name="owl-panel" class="owl-panel blocks-input">
                    <ui:Label name="owl-hint" class="hint" />
                    <ui:VisualElement class="row">
                        <ui:Button name="owl-rotate" text="Rotate" class="small-button" />
                        <ui:Button name="owl-patrol" text="Edit patrol" class="small-button" />
                        <ui:Button name="owl-clear" text="Clear patrol" class="small-button" />
                        <ui:Button name="owl-close" text="Done" class="small-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="tool-hint" class="hint" picking-mode="Ignore" />
                <ui:VisualElement name="tools" class="tools blocks-input" />
                <ui:ScrollView name="tray-scroll" mode="Horizontal" class="tray-scroll blocks-input">
                    <ui:VisualElement name="tray" class="tray" />
                </ui:ScrollView>
                <ui:VisualElement class="actions blocks-input">
                    <ui:Button name="undo" text="Undo" class="action" />
                    <ui:Button name="redo" text="Redo" class="action" />
                    <ui:Button name="verify" text="Verify" class="action dev" />
                    <ui:Button name="test" text="Test" class="action primary" />
                    <ui:Button name="publish" text="Publish" class="action primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
